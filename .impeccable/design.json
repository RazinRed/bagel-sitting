  "narrative": {
    "northStar": "The Sticker Sheet",
    "overview": "The guide is a page torn from a kawaii memo pad, with Bagel's sticker sheet clipped on top. Each step of the visit is one memo; finishing it earns a die-cut sticker, so progress is literally a sheet filling up. It is cute and pink because the owners pinned that, but the cuteness lives in materials (strawberry-milk paper, keylined stickers, rounded lettering) rather than in decoration, so the task always reads first.",
    "keyCharacteristics": [
      "Strawberry-milk ground, white memo sheets, plum ink, raspberry for anything the sitter must act on or read exactly.",
      "One rounded face for everything, including the kettle's 功能 / 取消 label.",
      "Die-cut stickers (circle, heart, star, flower) in pink, butter, mint, sky and lilac mark done-state and nothing else.",
      "A real night mode for a dim flat: deep rose, low glare, photos slightly dimmed."
    ],
    "rules": [
      { "name": "The Stickers Mean Done Rule", "body": "A sticker appears only where a step is finished. Empty is always a dashed outline with the step number; never use sticker shapes as decoration.", "section": "colors" },
      { "name": "The Raspberry Reads Rule", "body": "Any pink text smaller than about 24px uses Raspberry Ink, not Sticker Pink.", "section": "colors" },
      { "name": "The One Number Rule", "body": "Each step has at most one poster-size quantity, set as a true fraction or symbol (⅓, ½, ×2, 40°C), never spelled out.", "section": "typography" },
      { "name": "The No Kicker Rule", "body": "No small label sits above a heading. Progress lives in the sticker sheet card; the step number lives in the memo's sticker slot.", "section": "typography" }
    ],
    "dos": [
      "Do keep the current step, its quantity and the Done button visible together on a 390 × 844 phone.",
      "Do put every owner detail inside the step that needs it, next to that step's photo.",
      "Do use Raspberry Ink for any pink text below about 24px.",
      "Do keep photos at their real proportions and offer tap to enlarge."
    ],
    "donts": [
      "Don't use stickers, hearts or stars as decoration; they mean \"done\".",
      "Don't set a small uppercase label above a heading.",
      "Don't let Sticker Pink carry body-size text; it fails contrast on white.",
      "Don't brighten warnings in night mode; they use the deep alert colour, not glowing pink."
    ]
  }
